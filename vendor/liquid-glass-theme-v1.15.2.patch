+  isolation: isolate;
+  border-radius: var(--lg-radius);
+  background: linear-gradient(180deg, var(--lg-fill-top), transparent 60%), var(--lg-fill);
+  -webkit-backdrop-filter: blur(24px) saturate(160%) brightness(0.9);
+  backdrop-filter: blur(24px) saturate(160%) brightness(0.9);
+  /* 厚度：上緣受光、下緣透光（光線穿過玻璃後在底部聚集），比單一細線更立體 */
+  box-shadow:
+    inset 0 0 0 0.5px var(--lg-hairline),
+    inset 0 1px 0 rgba(255, 255, 255, 0.13),
+    inset 0 -1px 0 rgba(255, 255, 255, 0.05),
+    inset 0 -14px 22px -16px rgba(255, 255, 255, 0.09),
+    var(--lg-shadow);
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
+  -webkit-font-smoothing: antialiased;
+}
+
+[data-theme='light'] .lg {
+  -webkit-backdrop-filter: blur(18px) saturate(210%) brightness(1.1);
+  backdrop-filter: blur(18px) saturate(210%) brightness(1.1);
+  box-shadow:
+    inset 0 0 0 0.5px var(--lg-hairline),
+    inset 0 1px 0.5px rgba(255, 255, 255, 0.9),
+    inset 0 -1px 0.5px rgba(255, 255, 255, 0.35),
+    var(--lg-shadow);
