+.sys-bar button,
+.sys-bar .navigation-link {
+    border-radius: 9999px;
+    transition: background-color 0.25s ease, color 0.25s ease, transform 0.5s var(--lg-spring);
+}
+
+.sys-bar a:hover,
+.sys-bar button:hover,
+.sys-bar .navigation-link:hover {
+    background-color: var(--sys-hover);
+}
+
+.sys-bar a.active {
+    background-color: var(--sys-select);
+}
+
+.sys-bar a:active,
+.sys-bar button:active {
+    transform: scale(0.94);
+}
+
