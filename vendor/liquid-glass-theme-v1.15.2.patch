+        'radial-gradient(48rem 30rem at 4% -4rem, rgba(175, 82, 222, 0.24), transparent 70%)',
+        'radial-gradient(40rem 26rem at 52% 14rem, rgba(255, 149, 0, 0.1), transparent 70%)',
