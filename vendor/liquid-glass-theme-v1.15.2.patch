+/** 液態玻璃引擎（liquid-glass.js）的型別。引擎在載入時自動掛到 window.LiquidGlass。 */
+export {};
+
+declare global {
+    interface Window {
+        LiquidGlass?: {
+            supported: boolean;
+            watch: (selector: string) => void;
+            attach: (el: HTMLElement) => void;
+            detach: (el: HTMLElement) => void;
+            refresh: (el?: HTMLElement) => void;
+            morph: (el: HTMLElement, change: () => void, ms?: number) => void;
+        };
+    }
+}
