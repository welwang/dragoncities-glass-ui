+const families = ['gray', 'blue', 'red', 'green', 'yellow', 'cyan'];
+
+function channels(hex) {
+    const h = hex.replace('#', '');
+    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)).join(' ');
+}
