diff --git a/resources/scripts/system-theme/Spoiler.tsx b/resources/scripts/system-theme/Spoiler.tsx
new file mode 100644
index 0000000..ca13886
--- /dev/null
+++ b/resources/scripts/system-theme/Spoiler.tsx
@@ -0,0 +1,58 @@
+import React, { useEffect, useRef, useState } from 'react';
+import classNames from 'classnames';
+
+/**
+ * 防劇透霧面玻璃：把 IP、連線位址等敏感文字蓋在霧面玻璃下，點一下才顯示。
+ * - 預設隱藏；顯示 20 秒後自動霧化回去（直播、截圖時比較安全）
+ * - 隱藏時第一次點擊只負責顯示，不會觸發裡面的「點擊複製」
+ * - 鍵盤：Tab 到上面按 Enter / 空白鍵顯示
+ * 外觀見 system-theme/roles.css 的 .sys-spoiler
+ */
+interface Props {
+    children: React.ReactNode;
+    /** 顯示後多久自動隱藏（毫秒），0 = 不自動隱藏 */
+    autoHide?: number;
+    /** block = 包住整個輸入框之類的區塊元素（以 display:block 呈現） */
+    block?: boolean;
+    className?: string;
+    label?: string;
+}
+
+const Spoiler = ({ children, autoHide = 20000, block, className, label = 'IP 位址' }: Props) => {
+    const [hidden, setHidden] = useState(true);
+    const timer = useRef<ReturnType<typeof setTimeout>>();
+
+    useEffect(() => {
+        if (hidden || !autoHide) return;
+        timer.current = setTimeout(() => setHidden(true), autoHide);
+        return () => clearTimeout(timer.current);
+    }, [hidden, autoHide]);
+
+    const reveal = (e: React.SyntheticEvent) => {
+        if (!hidden) return;
+        e.preventDefault();
+        e.stopPropagation();
+        setHidden(false);
+    };
+
+    return (
+        <span
+            className={classNames('sys-spoiler', { 'sys-spoiler-block': block }, className)}
+            data-hidden={hidden ? '' : undefined}
+            onClickCapture={reveal}
+            onKeyDown={(e: React.KeyboardEvent) => {
+                if (hidden && (e.key === 'Enter' || e.key === ' ')) reveal(e);
+            }}
+            role={hidden ? 'button' : undefined}
+            tabIndex={hidden ? 0 : undefined}
+            aria-label={hidden ? `${label}已隱藏，按一下顯示` : undefined}
+            title={hidden ? '點一下顯示' : undefined}
+        >
+            <span className={'sys-spoiler-content'} aria-hidden={hidden}>
+                {children}
+            </span>
+        </span>
+    );
+};
+
+export default Spoiler;
diff --git a/resources/scripts/system-theme/liquid-glass.css b/resources/scripts/system-theme/liquid-glass.css
new file mode 100644
index 0000000..f677903
--- /dev/null
+++ b/resources/scripts/system-theme/liquid-glass.css
@@ -0,0 +1,116 @@
+/* Liquid Glass v2 — 搭配 liquid-glass.js
+ * 原則：玻璃只給「浮在內容上方的控制層」（導覽列、分頁列、按鈕、選單、提示），內容卡片用實心表面。
+ */
+:root {
+  --lg-radius: 24px;
+  /* 深色：煙燻玻璃。比「全透明」多一點霧與底色，背後的字不會搶眼，質感來自邊緣高光與厚度 */
+  --lg-fill: rgba(30, 32, 38, 0.30);
+  --lg-fill-top: rgba(255, 255, 255, 0.065);
+  --lg-hairline: rgba(255, 255, 255, 0.11);     /* 0.5px 外框 */
+  --lg-shadow: 0 14px 40px -12px rgba(0, 0, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.22);
+  --lg-glow: rgba(255, 255, 255, 0.16);         /* 觸控光暈 */
+  --lg-sat: 1.5;
+  --lg-bright: 0.9;
+  --lg-spec: 0.62;                              /* 曲面高光強度（引擎讀這個值產生高光） */
+  --lg-frost: 3.2;                              /* 玻璃內的霧化（px，引擎讀這個值） */
