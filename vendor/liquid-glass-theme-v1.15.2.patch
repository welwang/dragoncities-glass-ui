+    cyan: Object.assign({}, dark.cyan, { 300: '#0083b8', 400: '#0a9ed6', 500: '#32ade6', 600: '#0083b8' }),
+};
+
+/* 桌布：玻璃要有東西可以折射；固定在視窗，內容在上面捲動 */
+const wallpaper = {
+    dark: [
+        'radial-gradient(60rem 36rem at 85% -10rem, rgba(10, 132, 255, 0.2), transparent 70%)',
+        'radial-gradient(50rem 30rem at 0% -8rem, rgba(191, 90, 242, 0.13), transparent 70%)',
