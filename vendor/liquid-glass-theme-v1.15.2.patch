+  content: "";
+  position: absolute; inset: 0; z-index: -1;
+  border-radius: inherit; pointer-events: none;
+  background:
+    radial-gradient(90% 60% at 20% 0%, rgba(255, 255, 255, 0.16), transparent 60%),
+    radial-gradient(60% 50% at 85% 100%, rgba(255, 255, 255, 0.06), transparent 70%);
+}
+
+/* 觸控光暈：從手指位置擴散 */
+.lg::after {
+  content: "";
+  position: absolute; inset: 0; z-index: -1;
+  border-radius: inherit; pointer-events: none;
+  background: radial-gradient(circle at var(--lg-px, 50%) var(--lg-py, 50%), var(--lg-glow), transparent 70%);
+  background-size: 100% 100%;
+  opacity: 0;
+  transition: opacity 0.45s ease;
+}
+
+/* ---------- 交互 ---------- */
+.lg-press { cursor: pointer; -webkit-tap-highlight-color: transparent; touch-action: manipulation; transition: transform 0.55s var(--lg-spring), box-shadow 0.3s ease; }
+@media (hover: hover) { .lg-press:hover::after { opacity: 0.35; } }
+.lg-press:active::after { opacity: 1; transition-duration: 0.12s; }
+.lg-press:active {
+  transform: scale(1.07);                       /* iOS 26：按下時玻璃鼓起，放開彈回 */
+  transition-duration: 0.22s;
+  transition-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1.2);
+}
+.lg-press:focus-visible { outline: 2px solid rgba(10, 132, 255, 0.9); outline-offset: 3px; }
+
+/* 有色玻璃 */
+.lg-tint {
+  --lg-fill-top: color-mix(in srgb, var(--lg-tint-color) 62%, transparent);
+  --lg-fill: color-mix(in srgb, var(--lg-tint-color) 48%, transparent);
+  --lg-glow: rgba(255, 255, 255, 0.32);
+}
+
+.lg[aria-disabled="true"], .lg:disabled { opacity: 0.4; pointer-events: none; }
+
+/* ---------- 無障礙 ---------- */
+@media (prefers-reduced-motion: reduce) {
+  .lg, .lg-press:active { transition: none; transform: none; }
+}
+@media (prefers-reduced-transparency: reduce) {
+  .lg, .lg-refraction .lg[style*="--lg-filter"] { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgb(var(--c-gray-700, 44 44 46)); }
+}
