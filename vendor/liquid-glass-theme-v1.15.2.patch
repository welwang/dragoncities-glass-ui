+        mono: ['"SF Mono"', 'ui-monospace', '"Cascadia Mono"', '"JetBrains Mono"', 'Consolas', 'monospace'],
+    },
+
+    /* 動態：iOS 預設彈簧（response 0.5 / damping 0.75）的近似曲線 */
+    spring:
