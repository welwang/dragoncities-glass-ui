+/** tokens.js 的型別（tokens.js 是 CommonJS，tailwind.config.js 也會讀它） */
+type Shades = Record<string, string>;
+type Palette = { gray: Shades; blue: Shades; red: Shades; green: Shades; yellow: Shades; cyan: Shades };
+
+declare const tokens: {
+    modes: { dark: Palette; light: Palette };
+    wallpaper: { dark: string; light: string };
+    cssVars: (mode: 'dark' | 'light') => string;
+    tailwindColors: (withAlpha: boolean) => Record<string, string | Shades>;
+    borderRadius: Record<string, string>;
+    fontFamily: Record<string, string[]>;
+    spring: string;
+};
+
+export = tokens;
