+    left: 0;
+    top: 0;
+    z-index: -1;
+    width: var(--ind-w, 0);
+    height: var(--ind-h, 0);
+    transform: translate(var(--ind-x, 0), var(--ind-y, 0));
+    border-radius: 9999px;
+    background: var(--sys-select);
+    box-shadow: var(--sys-select-shadow);
+    opacity: var(--ind-o, 0);
+    pointer-events: none;
+    transition: transform 0.55s var(--lg-spring), width 0.55s var(--lg-spring), height 0.55s var(--lg-spring),
+        opacity 0.2s ease;
+}
+
+.lg-ind-still::before {
+    transition: none;
+}
+
+.lg-ind > a.active,
+.lg-ind > .active {
+    background-color: transparent !important;
+}
+
+/* 透鏡（liquid-glass.js 建立）：膠囊移動時的放大鏡。
+   裡面是玻璃列內容的副本，以矢量放大（字清晰）。外層只負責平移（獨立圖層，移動不掉幀），
+   玻璃外觀和鼓起的縮放在 .sys-lens-view；不用 backdrop-filter（每幀重算模糊會掉幀），
+   用接近不透明的亮玻璃色蓋住底下原本的字，質感由高光、厚度和放大的副本呈現 */
+.sys-lens {
+    position: fixed;
+    left: 0;
+    top: 0;
+    z-index: 45;
+    pointer-events: none;
+    opacity: 0;
+    transition: opacity 0.16s ease;
+    will-change: transform, opacity;
+}
+
+.sys-lens.on {
+    opacity: 1;
+    transition-duration: 0.12s;
+}
+
+.sys-lens-view {
+    position: absolute;
+    inset: 0;
+    border-radius: 9999px;
+    transform-origin: 50% 50%;
+    background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.06) 55%, rgba(255, 255, 255, 0.1)), rgb(52, 52, 58);
+    box-shadow:
+        inset 0 0 0 0.5px rgba(255, 255, 255, 0.26),
+        inset 0 1px 0 rgba(255, 255, 255, 0.4),
+        inset 0 -1px 0 rgba(255, 255, 255, 0.12),
+        inset 0 -10px 16px -12px rgba(255, 255, 255, 0.18),
+        0 10px 26px -10px rgba(0, 0, 0, 0.55),
+        0 1px 3px rgba(0, 0, 0, 0.25);
+}
+
+.sys-lens-ink {
+    position: absolute;
+    inset: 0;
+    overflow: hidden;
+    border-radius: inherit;
+}
+
+[data-theme='light'] .sys-lens-view {
+    background: linear-gradient(180deg, #ffffff, #fafafd 55%, #f4f5fa);
+    box-shadow:
+        inset 0 0 0 0.5px rgba(0, 0, 0, 0.06),
+        inset 0 1px 0 rgba(255, 255, 255, 1),
+        inset 0 -1px 0 rgba(255, 255, 255, 0.6),
+        0 12px 26px -10px rgba(20, 30, 70, 0.3),
+        0 1px 3px rgba(20, 30, 70, 0.12);
+}
+
