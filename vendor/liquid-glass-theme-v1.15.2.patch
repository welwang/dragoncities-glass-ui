+/*
+ * 系統主題：元件「角色」規則。
+ * 每個共用元件只標記自己的角色，外觀統一在這裡定義，不在個別頁面客製。
+ *
+ *   玻璃控制層（浮在內容上方）  .lg + 角色
+ *     sys-bar     導覽列、分頁列
+ *     sys-sheet   對話框、彈出視窗
+ *     sys-menu    下拉選單、右鍵選單
+ *     sys-tip     提示框
+ *     sys-float   浮動工具列（例如檔案多選時的操作列）
+ *
+ *   實心內容層
+ *     內容框、卡片、輸入框直接用 tokens.js 的色階（700 / 600），不需要額外 class
+ *
+ *   交互
+ *     sys-press   實心控制項的按壓回饋（按鈕、清單列）
+ */
+
+/* ---------- 模式相關的疊加色（深色 / 淺色） ---------- */
+:root {
+    --sys-hover: rgba(255, 255, 255, 0.08);
+    --sys-select: rgba(255, 255, 255, 0.14);
+    --sys-select-shadow: inset 0 0.5px 0 rgba(255, 255, 255, 0.2);
+    --sys-glow: rgba(255, 255, 255, 0.12);
+}
+
+:root[data-theme='light'] {
+    --sys-hover: rgba(0, 0, 0, 0.06);
+    --sys-select: rgba(255, 255, 255, 0.92);
+    --sys-select-shadow: 0 1px 3px rgba(0, 0, 0, 0.12), 0 0 0 0.5px rgba(0, 0, 0, 0.04);
+    --sys-glow: rgba(255, 255, 255, 0.55);
