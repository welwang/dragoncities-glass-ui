+  --lg-fill: rgba(255, 255, 255, 0.14);
+  --lg-fill-top: rgba(255, 255, 255, 0.4);
+  --lg-hairline: rgba(0, 0, 0, 0.06);
+  --lg-shadow: 0 12px 36px -12px rgba(20, 30, 70, 0.22), 0 1px 2px rgba(20, 30, 70, 0.06);
+  --lg-glow: rgba(255, 255, 255, 0.7);
+  --lg-sat: 2.1;
+  --lg-bright: 1.1;
+  --lg-spec: 0.9;
+  --lg-frost: 2.2;
+}
+
+/* 零權重：元件自己的 absolute / sticky / fixed 一定優先 */
