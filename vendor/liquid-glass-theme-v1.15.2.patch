+
+/* 選單項目：iOS 用灰色反白，不用整條藍色 */
+.sys-menu a,
+.sys-menu button,
+.sys-menu [role='menuitem'] {
+    border-radius: 12px;
+}
+
+/* ---------- 交互 ---------- */
+
+/* 玻璃列：游標附近有一圈柔光，像光線在玻璃裡移動 */
+.sys-bar::after {
+    background: radial-gradient(220px circle at var(--lg-px, -999px) var(--lg-py, -999px), var(--sys-glow), transparent 70%);
+    transition: opacity 0.35s ease;
+}
+
+@media (hover: hover) {
+    .sys-bar:hover::after {
+        opacity: 1;
+    }
+}
+
+/* 頁面進場：淡入並以彈簧上浮 */
+@keyframes lg-rise {
+    from {
+        opacity: 0;
+        transform: translateY(10px);
+    }
+}
+
+.sys-page {
+    animation: lg-rise 0.5s var(--lg-spring) both;
+}
+
+/* 深色 / 淺色切換：從按下的位置以圓形展開（View Transitions；不支援的瀏覽器直接切換） */
+::view-transition-old(root),
+::view-transition-new(root) {
+    animation: none;
+    mix-blend-mode: normal;
+}
+
+/* 切換按鈕的圖示：太陽 / 月亮轉進來 */
+@keyframes lg-swap {
+    from {
+        opacity: 0;
+        transform: rotate(-90deg) scale(0.5);
+    }
+}
+
+.sys-swap {
+    animation: lg-swap 0.55s var(--lg-spring);
+}
+
+/* 勾選時的彈跳 */
+@keyframes lg-pop {
+    0% {
+        transform: scale(0.8);
+    }
+}
+
+.sys-press {
+    transition-property: transform, background-color, color, opacity, box-shadow;
+    transition-duration: 0.5s, 0.2s, 0.2s, 0.2s, 0.2s;
+    transition-timing-function: var(--lg-spring), ease, ease, ease, ease;
+}
+
+.sys-press:not(:disabled):active {
+    transform: scale(0.97);
+    transition-duration: 0.15s, 0.1s, 0.1s, 0.1s, 0.1s;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .sys-page,
+    .sys-swap {
+        animation: none;
+    }
+
+    .lg-ind::before,
+    .sys-press,
+    .sys-bar a,
+    .sys-bar button {
+        transition: none;
+    }
+
+    .sys-press:not(:disabled):active,
+    .sys-bar a:active,
+    .sys-bar button:active {
+        transform: none;
+    }
+}
