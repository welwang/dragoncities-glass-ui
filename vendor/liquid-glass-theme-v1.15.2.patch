+        black: '#000000',
+        white: '#ffffff',
+        primary: scale('blue'),
+        blue: scale('blue'),
+        gray: scale('gray'),
+        neutral: scale('gray'),
+        red: scale('red'),
+        green: scale('green'),
+        yellow: scale('yellow'),
+        cyan: scale('cyan'),
+    };
+}
+
+module.exports = {
+    /** 原始色值（hex），dark / light 兩套 */
+    modes: { dark, light },
+    wallpaper,
+    cssVars,
+    tailwindColors,
